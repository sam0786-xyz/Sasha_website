# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
# On Vercel, this is auto-injected by the Storage integration.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Create with: node -e "require('bcryptjs').hash('choose-a-long-password',12).then(console.log)"
ADMIN_EMAIL="info@sashagc.com"
ADMIN_PASSWORD_HASH=""
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional. OpenAI-compatible NVIDIA endpoint; never expose this key to the browser.
NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"
NEMOTRON_API_KEY=""
NEMOTRON_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"
# Add when confirmed. It will appear as a tap-to-call link on the site.
COMPANY_PHONE=""
